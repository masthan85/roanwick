# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
# 32+ random characters, for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ENV=development
PUBLIC_WEB_URL=http://localhost:3000

# Payments. "sandbox" needs no credentials and takes no real money.
PAYMENT_PROVIDER=sandbox
SANDBOX_WEBHOOK_SECRET=change-me-too
# Required only when PAYMENT_PROVIDER=stripe (use test-mode keys until live approval):
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email and SMS. "console" records and logs only.
EMAIL_PROVIDER=console
# SMTP_HOST= SMTP_PORT=587 SMTP_USER= SMTP_PASSWORD= EMAIL_FROM=
# SMS_PROVIDER=twilio TWILIO_ACCOUNT_SID= TWILIO_AUTH_TOKEN= TWILIO_FROM=

# Optional demo accounts (development only). Set both to seed them.
SEED_DEMO=0
SEED_ADMIN_PASSWORD=
# SENTRY_DSN=
